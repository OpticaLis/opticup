node_modules/

# .claude/ — track project skills only; explicitly ignore local Claude config.
# Pattern: ignore the whole dir, re-include skills tree, then specifically
# ignore the known per-user / per-machine items so they don't leak.
.claude/
!.claude/
!.claude/skills/
!.claude/skills/opticup-*/
!.claude/skills/opticup-*/**

# Local Claude config + scratch (per-user, per-machine, never committed)
.claude/launch.json
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/projects/
.claude/cookies.json
.claude/temp/
.claude/cache/
scripts/upload_to_airtable.js
scripts/config.json
scripts/start-watcher.bat
serve.js
watcher-deploy/daemon/opticupsyncwatcher.out.log

# Environment files
.env
.env.*
!.env.example

.mcp.json

# Cowork plugin build artifacts — rebuild via scripts/build-cowork-plugin.ps1
opticup-skills.plugin

# Module 3 Phase B §1.4 — exclude transient working folders
# discovery/ and audit-reports/ remain TRACKED — they have archival value
**/backups/
**/old prompts/
**/current prompt/
**/archive/

# CRM Phase B2 — intermediate import plan artifacts (regenerated by import-monday-data.mjs)
campaigns/supersale/scripts/_sql/
_rung1-chunks/
modules/Module 4 - CRM/go-live/_rung1-*/

# === SESSION HYGIENE — added 2026-05-02 per Supervisor Pattern 20 ===

# Sentinel auto-writes — regenerated every scan, no archival value
docs/guardian/*.md
docs/guardian/*/
# Lighthouse cron — committed reports + alerts (M3_LIGHTHOUSE_NIGHTLY_CRON)
# Note: directory-level ignore (`docs/guardian/`) was replaced with subdir-only
# (`docs/guardian/*/`) because git skips ignored directories entirely and
# wouldn't reach un-ignore patterns inside them. The un-ignore lines below
# now actually take effect.
!docs/guardian/lighthouse-reports/
!docs/guardian/lighthouse-reports/**
!docs/guardian/GUARDIAN_ALERTS.md
# Sentinel mission protocol docs are tracked (auto-write outputs are not — see ALERTS dir above)
!docs/guardian/sentinel/
!docs/guardian/sentinel/**

# Cowork session prompt artifacts — per-session, transient
outputs/

# Test scratch files at repo root — should never be created here
/.git-test-write
/.test-write-from-bash
/test-*.txt
/test-*.json

# Access ERP migration source DBs — large binaries, kept locally only
# (Daniel rotates these between machines; never tracked in git)
tests/*.accdb
tests/*.accdr

# Editor / OS scratch files
*.tmp
*.bak
~$*
.DS_Store
Thumbs.db

# Per-session QA artifacts at module root level (NOT inside SPEC folders — those are intentional)
modules/*/go-live/_qa_*.json
modules/*/go-live/qa-*.mjs

# M1 Lens catalog work-in-progress Excel (Daniel actively editing)
tests/קטלוג-עדשות-18.5.26.xls
