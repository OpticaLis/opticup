node_modules/
.claude/
# Track the Optic Up project skills — they're part of the codebase, not
# per-user Claude config. Everything else under .claude/ stays ignored
# (settings.local.json, session transcripts, etc.).
!.claude/
!.claude/skills/
!.claude/skills/opticup-*/
!.claude/skills/opticup-*/**
scripts/upload_to_airtable.js
scripts/config.json
scripts/start-watcher.bat
serve.js
watcher-deploy/daemon/opticupsyncwatcher.out.log

# Environment files
.env
.env.*
!.env.example

.mcp.json

# Cowork plugin build artifacts — rebuild via scripts/build-cowork-plugin.ps1
opticup-skills.plugin

# Module 3 Phase B §1.4 — exclude transient working folders
# discovery/ and audit-reports/ remain TRACKED — they have archival value
**/backups/
**/old prompts/
**/current prompt/
**/archive/

# Claude local settings
.claude/

# CRM Phase B2 — intermediate import plan artifacts (regenerated by import-monday-data.mjs)
campaigns/supersale/scripts/_sql/
_rung1-chunks/
modules/Module 4 - CRM/go-live/_rung1-*/

# === SESSION HYGIENE — added 2026-05-02 per Supervisor Pattern 20 ===

# Sentinel auto-writes — regenerated every scan, no archival value
docs/guardian/*.md
docs/guardian/

# Cowork session prompt artifacts — per-session, transient
outputs/

# Test scratch files at repo root — should never be created here
/.git-test-write
/.test-write-from-bash
/test-*.txt
/test-*.json

# Editor / OS scratch files
*.tmp
*.bak
~$*
.DS_Store
Thumbs.db

# Per-session QA artifacts at module root level (NOT inside SPEC folders — those are intentional)
modules/*/go-live/_qa_*.json
modules/*/go-live/qa-*.mjs
