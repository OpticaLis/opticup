ize:22px;font-weight:800;padding:22px 50px;border-radius:50px;border:1px solid rgba(255,255,255,.2);box-shadow:0 10px 30px #0009;text-shadow:0 1px 2px rgba(0,0,0,.3)}.ss-btn--hero:hover{transform:translateY(-3px) scale(1.02);box-shadow:0 20px 40px #000c;filter:brightness(1.1)}.ss-btn--primary{gap:12px;background:linear-gradient(135deg, #d4af37 0%, #aa8c2c 100%);color:#111;font-size:18px;font-weight:900;padding:16px 34px;border-radius:999px;border:1px solid rgba(0,0,0,.18);box-shadow:0 12px 28px #00000038,0 0 0 3px #d4af372e}.ss-btn--primary:hover{transform:translateY(-1px);filter:brightness(1.03);box-shadow:0 16px 36px #00000047,0 0 0 4px #d4af3738}.ss-proof-section{max-width:980px;margin:18px auto 24px;padding:0 14px}.ss-proof-img-wrap{background:#ffffffeb;border:1px solid rgba(0,0,0,.08);border-radius:18px;box-shadow:0 14px 40px #0000001a;overflow:hidden;transition:transform .25s ease,box-shadow .25s ease}.ss-proof-img-wrap:hover{transform:translateY(-2px);box-shadow:0 18px 55px #00000024}.ss-proof-img-wrap img{display:block;width:100%;height:auto}.ss-cta-light__card{max-width:500px;margin:15px auto 0;text-align:center;direction:ltr}.ss-cta-status-light{margin-bottom:10px}.ss-cta-pill-light{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid #e0e0e0;border-radius:50px;padding:8px 20px;font-size:14px;font-weight:600;color:#111}.ss-cta-dot-light{width:10px;height:10px;background:#25d366;border-radius:50%;display:inline-block;flex-shrink:0;animation:ss-cta-pulse 1.5s infinite}.ss-cta-text-light{color:#1a8d1a;font-weight:700}.ss-cta-limit-light{font-size:13px;color:#555;line-height:1.5;padding:0 10px}.ss-cta-limit-light strong{color:#333}@keyframes ss-cta-pulse{0%,to{opacity:1}50%{opacity:.4}}.ss-reviews-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;max-width:900px;margin:30px auto;padding:0 20px;position:relative}.ss-review-card{background:#fff;border-radius:12px;padding:25px 20px;text-align:center;box-shadow:0 4px 20px #0000000f;border:1px solid #f0e6d2;transition:transform .3s ease}.ss-review-card:hover{transform:translateY(-3px)}.ss-review-stars{color:#f5a623;font-size:20px;letter-spacing:2px;margin-bottom:12px}.ss-review-text{font-size:15px;color:#444;line-height:1.6;font-style:italic;margin:0}.ss-reviews-logo{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:80px;height:80px;background:linear-gradient(135deg,#c5a059,#946a00);border-radius:16px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:32px;z-index:10;box-shadow:0 8px 30px #0003;opacity:.9}.ss-luxury-section{background:#111111;padding:70px 0;color:#fff}.ss-luxury-inner{max-width:1100px;margin:0 auto;padding:0 20px;display:flex;align-items:center;gap:50px;direction:ltr}.ss-luxury-text{flex:1}.ss-luxury-title{font-size:32px;font-weight:900;color:#fff;margin-bottom:15px;font-family:Georgia,serif;font-style:italic}.ss-luxury-desc{font-size:16px;line-height:1.7;color:#ccc;margin-bottom:20px}.ss-luxury-list{list-style:none;padding:0;margin:0}.ss-luxury-list li{font-size:15px;color:#ddd;padding:6px 0;display:flex;align-items:center;gap:8px}.ss-luxury-list li:before{content:\"✓\";color:#c5a059;font-weight:700}.ss-luxury-video{flex:0 0 320px;border-radius:12px;overflow:hidden;box-shadow:0 20px 50px #0006}.ss-luxury-video iframe{width:100%;aspect-ratio:9/16;display:block;border:none}.ss-sticky{position:fixed;bottom:0;left:0;right:0;z-index:99999;background:linear-gradient(180deg,#1a1a1a,#111);border-top:2px solid #c5a059;padding:10px 20px;transform:translateY(100%);opacity:0;transition:transform .4s ease,opacity .4s ease;direction:ltr;font-family:Rubik,Heebo,sans-serif}.ss-sticky *{box-sizing:border-box}.ss-sticky.ss-on{transform:translateY(0);opacity:1}.ss-sticky-in{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:20px}.ss-sticky-right{display:flex;align-items:center;gap:10px;flex:1}.ss-sticky-right .dot{width:9px;height:9px;background:#25d366;border-radius:50%;display:inline-block;flex-shrink:0;animation:ss-pulse 1.5s infinite}.ss-sticky-right .ss-sticky-txt{color:#ffffffbf;font-size:13px;line-height:1.4}.ss-sticky-left{flex-shrink:0}@keyframes ss-pulse{0%,to{opacity:1}50%{opacity:.4}}.ss-foot{background:#111;color:#ffffffb3;padding:50px 20px 20px;direction:ltr;font-family:Rubik,Heebo,sans-serif;font-size:14px;line-height:1.6}.ss-foot *{box-sizing:border-box}.ss-foot-inner{max-width:1100px;margin:0 auto}.ss-foot-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin-bottom:35px}.ss-foot-grid h4{color:#c5a059;font-size:16px;font-weight:700;margin:0 0 12px}.ss-foot-grid p{margin:0 0 8px;font-size:14px;color:#fff9;line-height:1.5}.ss-foot-grid a{color:#ffffffb3;text-decoration:none;transition:color .3s}.ss-foot-grid a:hover{color:#c5a059}.ss-foot-grid ul{list-style:none;padding:0;margin:0}.ss-foot-grid ul li{margin-bottom:8px}.ss-foot-grid ul li a{font-size:14px}.ss-foot .ss-ft-link{display:inline-block;margin-top:8px;color:#c5a059;font-size:13px;font-weight:600;text-decoration:none;transition:opacity .3s}.ss-foot .ss-ft-link:hover{opacity:.8}.ss-foot .ss-foot-logo{display:flex;align-items:center;gap:10px;margin-bottom:12px}.ss-foot .ss-foot-logo-icon{width:32px;height:32px;background:linear-gradient(135deg,#c5a059,#946a00);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:14px}.ss-foot .ss-foot-logo span{color:#fff;font-weight:700;font-size:14px}.ss-foot .ss-foot-legal{text-align:right;font-size:11px;line-height:1.6;color:#ffffff80;border-top:1px solid rgba(255,255,255,.1);padding-top:25px}.ss-foot .ss-foot-legal p{margin-bottom:8px;font-size:11px;color:#ffffff80}.ss-foot .ss-foot-legal strong{color:#ffffffb3}.ss-foot .ss-foot-copy{margin-top:16px;font-size:10px;opacity:.7;border-top:1px solid rgba(255,255,255,.08);padding-top:10px}.ss-foot .ss-foot-copy a{color:inherit;text-decoration:underline}@media(max-width:991px){.ss-luxury-inner{flex-direction:column;text-align:center}.ss-luxury-video{flex:none;width:100%;max-width:320px;margin:0 auto}.ss-reviews-grid{grid-template-columns:1fr}}@media(max-width:768px){.ss-sec{padding:40px 0}.ss-hdr{padding:6px 12px}.ss-hdr-logo .t1{font-size:10px}.ss-hdr-logo-i{width:30px;height:30px;font-size:13px;border-radius:6px}.ss-hdr-info{font-size:11px}.ss-hdr-info .dot{width:8px;height:8px}.ss-hero-section{min-height:auto}.ss-hero-content{padding:40px 12px 60px}.ss-hero-eyebrow{font-size:14px;letter-spacing:1px;margin-bottom:10px}.ss-hero-title{font-size:32px;margin-bottom:10px}.ss-hero-subtitle{font-size:16px;line-height:1.3;margin-bottom:4px}.ss-trust-badges{gap:6px}.ss-trust-item{font-size:11px;padding:6px 10px}.ss-trust-icon{width:14px;height:14px}.ss-hero-footer{font-size:10px;opacity:.7}.ss-btn--hero{width:100%;padding:16px 20px;font-size:18px}.ss-btn--primary{width:100%;max-width:340px;padding:15px 18px;font-size:16px}.ss-foot-grid{grid-template-columns:1fr;gap:25px;text-align:center}.ss-foot .ss-foot-logo{justify-content:center}.ss-foot .ss-foot-legal{text-align:center}.ss-sticky-in{flex-direction:column;gap:8px;text-align:center}.ss-sticky-right{justify-content:center}.ss-sticky-right .ss-sticky-txt{font-size:11px}.ss-sticky-left{width:100%;text-align:center}.ss-luxury-inner{gap:30px}.ss-luxury-title{font-size:26px}.ss-reviews-grid{grid-template-columns:1fr}.ss-reviews-logo{width:60px;height:60px;font-size:24px;border-radius:12px}.ss-cta-light__card{max-width:90%;padding:0 5px}.ss-cta-pill-light{font-size:13px;padding:6px 16px}.ss-cta-limit-light{font-size:12px}}.ss-brands-card{max-width:1000px;margin:0 auto;padding:0 15px;direction:ltr}.ss-brands-card-inner{background:#fff;border-radius:12px;box-shadow:0 10px 40px #00000014;padding:40px;text-align:center;border:1px solid rgba(0,0,0,.05);position:relative;overflow:hidden}.ss-brands-card-inner:before{content:\"\";position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#c5a059,#f0e6d2,#c5a059)}.ss-brands-card-title{font-size:24px;font-weight:700;color:#111;margin-bottom:5px}.ss-brands-card-price{font-size:32px;font-weight:900;color:#c5a059;margin-bottom:30px;text-shadow:0 2px 5px rgba(0,0,0,.05)}.ss-brands-card-scroll-wrap{position:relative;max-width:100%;margin:0 auto}.ss-brands-logos-row{display:flex;flex-wrap:nowrap;align-items:center;gap:20px;overflow-x:auto;scroll-behavior:smooth;padding:10px 0 20px;margin:0 50px;scrollbar-width:none;-ms-overflow-style:none}.ss-brands-logos-row::-webkit-scrollbar{display:none}.ss-brand-logo-img{flex:0 0 auto;width:140px;height:80px;object-fit:contain;filter:grayscale(100%);opacity:.7;transition:all .3s;cursor:pointer}.ss-brand-logo-img:hover{filter:grayscale(0%);opacity:1;transform:scale(1.05)}.ss-brands-arrow{position:absolute;top:50%;transform:translateY(-50%);width:40px;height:40px;background:#fff;border-radius:50%;box-shadow:0 4px 10px #00000026;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:100;border:1px solid #eee;transition:all .2s;color:#333}.ss-brands-arrow:hover{background:#c5a059;color:#fff;border-color:#c5a059}.ss-brands-arrow-right{right:0}.ss-brands-arrow-left{left:0}.ss-brands-card-badge{display:inline-block;margin-top:20px;background:#f9f9f9;color:#555;padding:8px 20px;border-radius:30px;font-size:14px;font-weight:500;border:1px solid #eee}.ss-about-inner{max-width:1100px;margin:0 auto;padding:0 20px;display:flex;gap:50px;align-items:center;direction:ltr}.ss-about-text{flex:1}.ss-about-image{flex:0 0 400px;border-radius:12px;overflow:hidden;box-shadow:0 15px 40px #0000001a}@media(max-width:900px){.products-grid{grid-template-columns:repeat(2,1fr)!important;gap:15px!important}.products-grid .product-card div:first-child{height:140px!important;padding:10px!important}}@media(max-width:991px){.ss-about-inner{flex-direction:column;text-align:center}.ss-about-image{flex:none;width:100%;max-width:400px;margin:0 auto}}@media(max-width:768px){.ss-guarantee-grid{grid-template-columns:repeat(2,1fr)!important;gap:10px!important}.ss-foot-grid{grid-template-columns:1fr!important}.ss-brands-card-inner{padding:30px 15px}.ss-brands-logos-row{margin:0 30px;gap:15px}.ss-brand-logo-img{width:100px;height:60px}.ss-brands-arrow{width:32px;height:32px}section[style*=\"padding:20px;\"]>div[style*=\"display:flex\"][style*=\"900px\"]{flex-direction:column!important;text-align:center!important}section[style*=\"padding:20px;\"]>div[style*=\"display:flex\"][style*=\"900px\"]>div:first-child{width:120px!important;margin:0 auto 10px!important}}@media(max-width:600px){.ss-luxury-inner{flex-direction:column!important}.ss-luxury-video{flex:none!important;width:100%!important;max-width:320px!important;margin:0 auto!important}}.product-card:hover{transform:translateY(-5px);box-shadow:0 15px 40px #00000014;border-color:#f0e6d2!important}</style><div class=\"supersale-page\" dir=\"ltr\"><div class=\"ss-hdr\" id=\"ssHeader\"><div class=\"ss-hdr-in\"><div class=\"ss-hdr-logo\"><div class=\"ss-hdr-logo-i\">P</div><div><div class=\"t1\">События брендов<br><span>Оптика Призма</span></div></div></div><div class=\"ss-hdr-info\"><div class=\"dot\"></div><span><strong>Брендовые очки по специальным ценам</strong><br>Регистрация только по предварительной записи</span></div></div></div>"
