  {
    "id": "ss-header",
    "data": {
      "css": "",
      "html": "<style>body{background-color:#fcfbf8}.supersale-page{--ss-gold: #c5a059;--ss-gold-dark: #946a00;--ss-gold-light: #f0e6d2;--ss-gold-shine: #e8da94;--ss-gold-gradient: linear-gradient(135deg, #c5a059 0%, #946a00 100%);--ss-gold-btn: linear-gradient(135deg, #d4af37 0%, #aa8c2c 100%);--ss-text: #111111;--ss-white: #ffffff;--ss-bg: #fcfbf8;--ss-dark: #111111;--ss-dark-card: #1a1a1a;--ss-gray-300: #cccccc;--ss-gray-500: #777777;--ss-gray-600: #666666;--ss-gray-700: #555555;--ss-red: #d92e2e;--ss-green: #25D366;--ss-radius-sm: 6px;--ss-radius-md: 8px;--ss-radius-lg: 12px;--ss-radius-pill: 50px;--ss-content-max: 1400px;--ss-text-max: 1000px;--ss-shadow-sm: 0 4px 15px rgba(0,0,0,.1);--ss-shadow-md: 0 10px 30px rgba(0,0,0,.15);--ss-shadow-lg: 0 15px 40px rgba(0,0,0,.2);--ss-transition: all .3s ease}.supersale-page{direction:ltr;font-family:Rubik,Heebo,sans-serif;color:#111111;line-height:1.45;background-color:#fcfbf8}.supersale-page *,.supersale-page *:before,.supersale-page *:after{box-sizing:border-box}.ss-sec{width:100%;margin:0;padding:50px 0;position:relative}.ss-sec-inner{max-width:1400px;margin:0 auto;padding:0 20px;width:100%}.ss-fade{opacity:0;transform:translateY(25px);transition:opacity .6s ease,transform .6s ease}.ss-fade.ss-vis{opacity:1;transform:translateY(0)}.ss-hdr{position:fixed;top:0;left:0;right:0;z-index:99999;background:linear-gradient(180deg,#111,#0a0a0a);border-bottom:2px solid #c5a059;padding:8px 20px;transform:translateY(-100%);opacity:0;transition:transform .4s ease,opacity .4s ease;direction:ltr;font-family:Rubik,Heebo,sans-serif}.ss-hdr *{box-sizing:border-box}.ss-hdr.ss-scrolled{transform:translateY(0);opacity:1}.ss-hdr-in{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:15px}.ss-hdr-logo{display:flex;align-items:center;gap:10px}.ss-hdr-logo-i{width:36px;height:36px;background:linear-gradient(135deg,#c5a059,#946a00);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:16px;flex-shrink:0}.ss-hdr-logo .t1{color:#fff;font-size:12px;font-weight:500;line-height:1.3}.ss-hdr-logo .t1 span{color:#c5a059;font-weight:700}.ss-hdr-info{display:flex;align-items:center;gap:8px;color:#fff;font-size:13px;line-height:1.3}.ss-hdr-info .dot{width:10px;height:10px;background:#25d366;border-radius:50%;flex-shrink:0;animation:ss-hdr-pulse 1.5s infinite}.ss-hdr-info strong{color:#c5a059}@keyframes ss-hdr-pulse{0%,to{opacity:1;box-shadow:0 0 #25d36699}50%{opacity:.7;box-shadow:0 0 0 6px #25d36600}}.ss-hero-section{position:relative;min-height:100vh;display:flex;align-items:center;justify-content:center;overflow:hidden}.ss-hero-video{position:absolute;inset:0;z-index:0}.ss-hero-video iframe{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:177.78vh;height:100vh;min-width:100%;min-height:100%;pointer-events:none}.ss-hero-overlay{position:absolute;inset:0;z-index:1;background:#000;opacity:.84}.ss-hero-content{position:relative;z-index:10;text-align:center;max-width:1000px;margin:0 auto;padding:80px 20px;color:#fff}.ss-hero-eyebrow{color:#c5a059;font-size:20px;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:20px;text-shadow:0 2px 4px rgba(0,0,0,.8);border-bottom:1px solid rgba(197,160,89,.3);padding-bottom:5px;display:inline-block}.ss-hero-title{font-size:56px;font-weight:900;margin-bottom:25px;color:#fff;text-shadow:0 2px 10px rgba(0,0,0,.8),0 5px 20px rgba(0,0,0,.5);line-height:1.1}.ss-hero-white-tight{color:#fff;display:block;line-height:1;margin-bottom:15px}.ss-gold-text{color:#c5a059;font-weight:900;text-shadow:0 2px 10px rgba(0,0,0,.9)}.ss-hero-highlight{color:#c5a059;position:relative;display:inline-block;text-shadow:0 2px 10px rgba(0,0,0,.9);line-height:1.4}.ss-hero-highlight:after{content:\"\";display:block;width:100%;height:6px;background:#c5a059;position:absolute;bottom:5px;right:0;z-index:-1;box-shadow:0 2px 5px #00000080;border-radius:2px}.ss-hero-subtitle{